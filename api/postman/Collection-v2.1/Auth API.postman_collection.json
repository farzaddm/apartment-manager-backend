		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// شکل پاسخ تو: data.access_token و data.refresh_token\r",
							"const json = pm.response.json();\r",
							"\r",
							"pm.test(\"Login success\", function () {\r",
							"  pm.expect(json).to.have.property(\"success\", true);\r",
							"});\r",
							"\r",
							"const access = json?.data?.access_token;\r",
							"const refresh = json?.data?.refresh_token;\r",
							"\r",
							"pm.test(\"Tokens exist\", function () {\r",
							"  pm.expect(access).to.be.a(\"string\").and.not.empty;\r",
							"  pm.expect(refresh).to.be.a(\"string\").and.not.empty;\r",
							"});\r",
							"\r",
							"// ذخیره در Global Variables\r",
							"pm.globals.set(\"access_token\", access);\r",
							"pm.globals.set(\"refresh_token\", refresh);\r",
							"\r",
							"// اختیاری\r",
							"pm.globals.set(\"user_id\", json?.data?.user?.ID);\r",
							"\r",
							"console.log(\"Saved access_token & refresh_token (GLOBAL)\");\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"voldemort_ad\",\n    \"password\": \"123456\"\n}",
