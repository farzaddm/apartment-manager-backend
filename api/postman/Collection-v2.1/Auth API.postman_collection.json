		{
			"name": "Refresh Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();\r",
							"\r",
							"// دریافت توکن‌ها از پاسخ (فرض می‌کنیم در ساختار data هستند)\r",
							"const access = json?.data?.access_token;\r",
							"const refresh = json?.data?.refresh_token;\r",
							"\r",
							"// ذخیره در Global\r",
							"if (access) {\r",
							"    pm.globals.set(\"access_token\", access);\r",
							"    console.log(\"Access Token updated globally.\");\r",
							"}\r",
							"\r",
							"if (refresh) {\r",
							"    pm.globals.set(\"refresh_token\", refresh);\r",
							"    console.log(\"Refresh Token updated globally.\");\r",
							"}\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\":  \"{{refresh_token}}\" \n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "localhost:8080/refresh",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"refresh"
					]
				}
			},
			"response": []
